#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

#define DEF 0
#define MOD 1
#define NUM 2
#define FUN 3
#define SYM 4
#define MOUSE 5
#define DRAG 6
#define SNIP 7
/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>;

        snipe {
            layers = <SNIP>;
            input-processors = <&zip_xy_scaler 1 3>;
        };

        scroll {
            layers = <DRAG>;
            input-processors = <&zip_xy_scaler 1 3>, <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings =
                <&kp>,
                <&kp>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings = 
                <&mo>,
                <&kp>;
        };
    };

    chosen {
        zmk,matrix_transform = &five_column_transform;
    };

  keymap {
        compatible = "zmk,keymap";

        DEF_layer {
            bindings = <
            &kp Q       &kp W           &kp E                   &kp R             &kp T               &kp Y         &kp U              &kp I        &kp O            &kp P            
            &lt SYM A   &ht LEFT_ALT S  &ht LCTRL D             &ht LEFT_SHIFT F  &ht LWIN G          &ht RWIN H    &ht RIGHT_SHIFT J  &ht RCTRL K  &ht RIGHT_ALT L  &lt MOD SEMICOLON
            &kp Z       &kp X           &kp C                   &lt MOUSE V       &kp B               &kp N         &lt FUN M          &kp COMMA    &kp DOT          &kp SLASH        
                                        &ht LEFT_SHIFT DELETE   &kp BACKSPACE     &mkp LCLK           &kp ENTER     &lt NUM SPACE
            >;
        };

        MOD_layer {
            bindings = <
            &none       &none           &kp HOME     &kp UP_ARROW     &kp END              &none         &none              &none        &none            &none            
            &kp TAB     &kp LEFT_ARROW  &kp DOWN     &kp RIGHT        &none                &kp RIGHT_GUI &kp RSHIFT         &kp RCTRL    &kp RIGHT_ALT    &none            
            &none       &kp PAGE_UP     &kp ESCAPE   &kp PAGE_DOWN    &none                &none         &none              &none        &none            &none            
                                        &none        &none            &none                &kp MINUS     &kp UNDER
            >;
        };

        NUM_layer {
            bindings = <
            &kp F1      &kp F2          &kp F3       &kp F4           &kp F5               &kp F6        &kp F7             &kp F8       &kp F9           &kp F10          
            &kp N1      &kp N2          &kp N3       &kp N4           &kp N5               &kp N6        &kp N7             &kp N8       &kp N9           &kp N0           
            &none       &none           &kp MINUS    &kp PLUS         &kp EQUAL            &kp EQUAL     &kp PLUS           &kp MINUS    &none            &none            
                                        &kp LALT     &kp LSHFT        &kp LCTRL            &none         &none
            >;
        };

        FUN_layer {
            bindings = <
            &kp F1      &kp F2          &kp F3       &kp F4           &kp F5               &none         &none              &bt BT_SEL 0 &bt BT_SEL 3     &none            
            &kp F6      &kp F7          &kp F8       &kp F9           &kp F10              &none         &none              &bt BT_SEL 1 &bt BT_SEL 4     &none            
            &kp F11     &kp F12         &none        &none            &bootloader          &none         &none              &bt BT_SEL 2 &none            &bt BT_CLR       
                                        &none        &kp C_VOL_DOWN   &kp C_VOL_UP         &kp C_AC_ZOOM_IN &kp C_AC_ZOOM_OUT
            >;
        };

        SYM_layer {
            bindings = <
            &none       &kp CAPS        &kp PLUS     &kp SQT          &kp CARET            &kp ASTRK     &kp DOUBLE_QUOTES  &kp AT       &kp RMETA        &kp PERCENT      
            &none       &kp LEFT_BRACKET &kp LS(LEFT_BRACKET) &kp LEFT_PARENTHESIS &kp PIPE  &kp SLASH     &kp RIGHT_PARENTHESIS &kp LS(RIGHT_BRACKET) &kp RIGHT_BRACKET &kp COLON  
            &none       &kp AMPERSAND   &kp GRAVE    &kp EXCLAMATION  &kp PLUS             &kp BACKSLASH &kp QUESTION       &kp TILDE    &kp DOLLAR       &kp HASH         
                                        &none        &none            &none                &none         &none
            >;
        };

        MOUSE_layer {
            bindings = <
            &none       &none           &none        &none            &none                &none         &none              &mmv MOVE_UP &none            &none            
            &none       &none           &none        &none            &none                &msc SCRL_LEFT &mmv MOVE_LEFT     &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_RIGHT  
            &none       &none           &mo SNIP     &none            &none                &none         &msc SCRL_UP       &msc SCRL_DOWN &none          &none            
                                        &mkp RCLK    &mo DRAG         &mkp LCLK            &kp RCTRL     &kp RSHFT
            >;
        };

        DRAG_layer {
            bindings = <
            &none       &none           &none        &none            &none                &none         &none              &none        &none            &none            
            &none       &none           &none        &none            &none                &none         &none              &none        &none            &none            
            &none       &none           &mo SNIP     &none            &none                &none         &none              &none        &none            &none            
                                        &mkp RCLK    &trans           &mkp LCLK            &none         &none
            >;
        };

        SNIP_layer {
            bindings = <
            &none       &none           &none        &none            &none                &none         &none              &none        &none            &none            
            &none       &none           &none        &none            &none                &none         &none              &none        &none            &none            
            &none       &none           &trans       &none            &none                &none         &none              &none        &none            &none            
                                        &mkp RCLK    &mo DRAG         &mkp LCLK            &none         &none
            >;
        };
    };
};